{
  "name": "omni-interface",
  "private": true,
  "version": "1.0.15",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "deploy": "git push origin main && bash deploy.sh",
    "electron:dev": "ELECTRON=true NODE_ENV=development vite --port=3000",
    "electron:start": "ELECTRON=true NODE_ENV=development vite --port=3000 & sleep 3 && electron .",
    "electron:build": "ELECTRON=true vite build && electron-builder"
  },
  "dependencies": {
    "@mercuryworkshop/epoxy-transport": "^3.0.1",
    "@mercuryworkshop/scramjet-controller": "^0.0.9",
    "@react-google-maps/api": "^2.20.8",
    "@types/leaflet": "^1.9.14",
    "@vitejs/plugin-react": "^6.0.1",
    "electron-updater": "^6.8.9",
    "leaflet": "^1.9.4",
    "libcurl.js": "^0.7.4",
    "lucide-react": "^0.446.0",
    "motion": "^12.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "vite-plugin-static-copy": "^4.1.0"
  },
  "build": {
    "appId": "com.omni.os1",
    "productName": "OS¹",
    "icon": "build/icon.png",
    "directories": {
      "output": "dist-installer"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "afterSign": "build/notarize.cjs",
    "publish": {
      "provider": "github",
      "owner": "henrifraso",
      "repo": "your-github-space"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "OS1-mac-${arch}.${ext}"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "OS1-windows.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "@electron/rebuild": "^4.0.4",
    "@eslint/js": "^9.39.5",
    "@ibm/plex": "^6.4.1",
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@vercel/node": "^5.7.15",
    "electron": "^41.5.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "node-addon-api": "^8.8.0",
    "prettier": "^3.9.5",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.63.0",
    "vite-plugin-electron": "^0.29.1",
    "vite-plugin-electron-renderer": "^0.14.7"
  }
}
